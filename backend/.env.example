# Copy to .env and fill in. Never commit the real .env.

ENVIRONMENT=development

# --- Database ---
# NOTE on the role/user:
#  - Docker Postgres: the classic default is user "postgres" / password "postgres"
#    -> postgresql+asyncpg://postgres:postgres@localhost:5432/weightprogram
#  - Homebrew Postgres (macOS): there is NO "postgres" role by default. The
#    superuser role is your macOS username with no password. Run `whoami` and use:
#    -> postgresql+asyncpg://<your-username>@localhost:5432/weightprogram
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/weightprogram

# --- JWT (generate a strong secret, e.g. `openssl rand -hex 32`) ---
JWT_SECRET=replace-with-openssl-rand-hex-32
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=45

# --- OTP ---
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=30
OTP_REQUESTS_PER_HOUR=5

# --- AWS SES ---
# Credentials come from the standard AWS chain (env vars, ~/.aws/credentials,
# or the instance/task IAM role when deployed). Do NOT hardcode keys here.
AWS_REGION=us-east-1
SES_FROM_EMAIL=no-reply@yourdomain.com   # must be a verified SES identity
# SES_CONFIGURATION_SET=your-config-set

# Set to false to actually send via SES. true = print codes to the log (local dev).
EMAIL_DEV_MODE=true

# --- Image storage (Increment 2) ---
# local = write to disk (dev). s3 = production bucket (server-side encrypted).
IMAGE_STORAGE_BACKEND=local
S3_BUCKET=weightprogram-captures
LOCAL_IMAGE_DIR=./_local_images

# --- Vision recognition (Increment 2, spec R1b: Bedrock + Claude) ---
# stub = deterministic fake (no AWS needed, great for testing the flow).
# bedrock = real Claude multimodal recognition via Bedrock.
VISION_PROVIDER=stub
# Use a Claude multimodal model id / inference-profile ARN enabled in YOUR
# Bedrock account + region (ids vary by region/account — check the console).
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=1024

# --- Onboarding defaults ---
DEFAULT_SESSION_MINUTES=60
DEFAULT_EXPERIENCE=conservative
