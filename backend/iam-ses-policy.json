{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSendOtpEmail",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ses:FromAddress": "no-reply@yourdomain.com"
        }
      }
    }
  ]
}
